# Copy this file to .env and replace every value marked for your installation.
# Keep the database password URL-safe, or percent-encode it in DATABASE_URL.
POSTGRES_DB=cleardeck
POSTGRES_USER=cleardeck
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://cleardeck:replace-with-a-long-random-password@db:5432/cleardeck
SERVER_DOMAIN=cleardeck.example.com
