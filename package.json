{
  "name": "cleardeck",
  "productName": "ClearDeck",
  "version": "2.3.0",
  "description": "ClearDeck – Desktop-App für Team-, Historie- und VZÄ-Übersicht (SQLite, Export, Verschlüsselung).",
  "main": ".webpack/main",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "start": "node scripts/start-dev.js",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:release": "electron-forge make && node scripts/generate-update-yml.js",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest",
    "nuke:dev": "node scripts/nuke-db.js dev",
    "nuke:prod": "node scripts/nuke-db.js prod",
    "nuke:all": "node scripts/nuke-db.js all",
    "dev:updates": "node scripts/start-dev.js --updates",
    "demo": "node scripts/start-demo.cjs"
  },
  "keywords": [],
  "author": {
    "name": "Torben Buck",
    "email": "mail@tbuck.de"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-webpack": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "39.2.4",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "jsdom": "^27.2.0",
    "node-loader": "^2.1.0",
    "patch-package": "^8.0.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.4",
    "typescript": "5.9.3",
    "vitest": "^4.0.15",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "better-sqlite3": "^12.5.0",
    "date-fns": "^4.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "^7.8.5",
    "xlsx": "^0.18.5"
  }
}
